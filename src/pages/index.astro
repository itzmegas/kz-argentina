---
import AppLayout from "@/layouts/AppLayout.astro";
import Layout from "../layouts/Layout.astro";
import { getNews } from "@/api";
import Stack from "@/components/layout/Stack.astro";
import { News } from "@/components/News";

import { newsParser } from "@/utils/newsParser";
const lastNews = await getNews();
---

<AppLayout>
  <div>
    {
      lastNews.map((itemNews) => (
        <News title={itemNews.title}>
          <p set:html={newsParser(itemNews.htmlContent)} />
        </News>
      ))
    }
  </div>
</AppLayout>
