---
import Flex from "@/components/layout/Flex.astro";
import Stack from "@/components/layout/Stack.astro";
import Layout from "./Layout.astro";
import Header from "@/components/layout/Header.astro";
import { TopFive } from "@/components/TopFive";
import { getTopFive } from "@/api";

import "@/globals.css";

const data = await getTopFive();
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<Layout>
  <div class="grid grid-rows-[auto_minmax(0px, 1fr)_auto] min-h-dvh">
    <Header />
    <div class="min-w-0 mx-auto overflow-hidden px-5">
      <div class="grid grid-cols-1 md:grid-cols-[250px_1fr_250px] gap-5">
        <div class="">SIDE LEFT</div>
        <div class="min-w-0">
          <slot />
        </div>
        <div>
          <TopFive client:load data={data} />
        </div>
      </div>
    </div>
    <div>footer</div>
  </div>
</Layout>
