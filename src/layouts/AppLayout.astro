---
import Flex from "@/components/layout/Flex.astro";
import Stack from "@/components/layout/Stack.astro";
import Layout from "./Layout.astro";
import Header from "@/components/layout/Header.astro";
import { TopFive } from "@/components/TopFive";
import { getTopFive } from "@/api";

import "@/globals.css";

const data = await getTopFive();
---

<Layout>
  <div class="grid grid-rows-[auto_minmax(0px, 1fr)_auto] min-h-dvh">
    <Header />
    <div class="min-w-0 max-w-screen-xl mx-auto overflow-hidden px-5">
      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto] gap-5">
        <div class="">SIDE LEFT</div>
        <div class="min-w-0">
          <slot />
        </div>
        <div class="">
          <TopFive client:load data={data} />
        </div>
      </div>
    </div>
    <div>footer</div>
  </div>
</Layout>
